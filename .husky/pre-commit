# Block env files. Only .env.example may be committed.
blocked=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env' | grep -vE '(^|/)\.env\.example$' || true)
if [ -n "$blocked" ]; then
  echo "Commit blocked: env files must never be committed:"
  echo "$blocked"
  exit 1
fi

# Scan staged files for keys and other secrets.
git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 -r npx --no-install secretlint --maskSecrets
